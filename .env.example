# The AIMART backend's API Gateway
VITE_API_BASE_URL=http://localhost:8000

# Razorpay public key (safe to expose client-side). Same key you put in the
# backend's PAYMENT/.env as RAZORPAY_KEY_ID. Leave blank to skip payment
# during checkout (the order will still be created).
VITE_RAZORPAY_KEY_ID=
